/* Swain — dark, minimal, feels like a conversation not a dashboard */

Screen {
    background: #0d0d0d;
    layers: base overlay;
}

#status-bar {
    background: #0a0a0a;
    border-bottom: solid #1a1a1a;
    height: 1;
    padding: 0 2;
    color: #555555;
}

#main {
    height: 1fr;
}

ChatLog {
    background: #111111;
    width: 3fr;
    padding: 1 2;
    border: none;
    scrollbar-background: #111111;
    scrollbar-color: #2a2a2a;
    scrollbar-color-hover: #3a3a3a;
}

Sidebar {
    width: 1fr;
    background: #0c0c0c;
    border-left: solid #1a1a1a;
    padding: 1 2;
}

#sb-brand {
    color: #00d4aa;
    text-style: bold;
    margin-bottom: 1;
}

#message-input {
    background: #0f0f0f;
    border-top: solid #1e1e1e;
    border-bottom: none;
    border-left: none;
    border-right: none;
    height: 3;
    padding: 0 2;
    color: #dddddd;
}

#message-input:focus {
    border-top: solid #00d4aa;
    background: #0f0f0f;
}

#footer {
    background: #0a0a0a;
    height: 1;
    padding: 0 2;
    border-top: solid #141414;
}
