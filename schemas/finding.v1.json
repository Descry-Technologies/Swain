{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://descry.dev/schemas/finding.v1.json",
  "title": "Finding",
  "description": "A security finding produced by a Descry worker",
  "type": "object",
  "required": ["schema_version", "id", "rule", "severity", "confidence", "title", "evidence"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "id": {
      "type": "string",
      "description": "Stable hash: sha256(rule + file_path_normalized + anchor). Survives line moves."
    },
    "rule": { "type": "string", "description": "Playbook rule ID, e.g. sast.xss.dangerously-set-innerhtml" },
    "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "info"] },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "cwe": { "type": "string", "description": "e.g. CWE-79", "pattern": "^CWE-[0-9]+$" },
    "owasp": { "type": "string", "description": "e.g. A03:2021" },
    "evidence": {
      "type": "object",
      "required": ["file", "anchor"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string", "description": "Repo-relative path" },
        "line_start": { "type": "integer", "minimum": 1 },
        "line_end": { "type": "integer", "minimum": 1 },
        "anchor": {
          "type": "string",
          "description": "Structural anchor: sha256 of normalized AST subtree or function signature. Stable across line moves."
        },
        "snippet_hash": { "type": "string", "description": "sha256 of the raw snippet for dedup" },
        "data_flow": { "type": "string", "description": "Human-readable taint path, e.g. req.query.id -> db.query()" },
        "reachable_routes": {
          "type": "array",
          "items": { "type": "string" },
          "description": "HTTP routes or code paths that reach this finding"
        }
      }
    },
    "exploitability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requires_auth": { "type": "boolean" },
        "requires_interaction": { "type": "boolean" },
        "network_exposed": { "type": "boolean" },
        "assessment": { "type": "string" }
      }
    },
    "remediation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string" },
        "patch_diff": { "type": "string", "description": "Unified diff of the suggested fix" },
        "references": { "type": "array", "items": { "type": "string" } }
      }
    },
    "suppression": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "suppressed": { "type": "boolean" },
        "reason": { "type": "string" },
        "expires_at": { "type": "string", "format": "date" },
        "suppressed_by": { "type": "string" },
        "suppressed_at": { "type": "string", "format": "date-time" }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["open", "fixed", "wontfix", "fp", "suppressed"] },
        "introduced_commit": { "type": "string" },
        "fixed_commit": { "type": "string" },
        "first_seen": { "type": "string", "format": "date-time" },
        "last_seen": { "type": "string", "format": "date-time" }
      }
    },
    "source": {
      "type": "object",
      "required": ["worker", "playbook", "playbook_version"],
      "additionalProperties": false,
      "properties": {
        "worker": { "type": "string", "enum": ["claude", "codex", "semgrep", "gitleaks", "osv", "mock"] },
        "model": { "type": "string" },
        "playbook": { "type": "string" },
        "playbook_version": { "type": "integer" },
        "run_id": { "type": "string" }
      }
    }
  }
}
